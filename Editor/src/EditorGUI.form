            <Property name="text" type="java.lang.String" value="Hier wird an mehrzeiligen Texten gearbeitet.&#xa;Wenn man &quot;Suchtext&quot; im Textelf an der Seite eingibt&#xa;und den Button &quot;Suchen&quot; bet&#xe4;tigt, dann soll Suchtext gefunden werden.&#xa;&#xa;SuChTeXt wird nur gefunden, wenn Gro&#xdf;schreibung ignoriert wird."/>
          </Properties>
